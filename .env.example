# Opinber slóð appsins, án skástriks í enda.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Vercel/Neon integration setur DATABASE_URL. Aðeins á vefþjóni.
DATABASE_URL=
# Bein tenging fyrir npm run db:migrate; aldrei -pooler í hostname.
DATABASE_URL_UNPOOLED=
# Neon Console → Auth → Configuration. Sama grein og DATABASE_URL.
NEON_AUTH_BASE_URL=
# openssl rand -hex 32 — einkalykill, aldrei NEXT_PUBLIC_ eða í GitHub.
NEON_AUTH_COOKIE_SECRET=
# Tölvupóstur: staðfest sendingarlén hjá Resend.
RESEND_API_KEY=
EMAIL_FROM=Hlýja <hlyja@example.is>
# openssl rand -hex 32
CRON_SECRET=
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:rekstur@example.is
